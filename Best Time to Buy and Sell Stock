# Problem Number: 121

class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        max_sum = 0
        sum = 0
        for i in range(len(prices)-1):
            difference = prices[i+1] - prices[i]
            sum += difference
            if sum < 0:
                sum = 0
            max_sum = max(max_sum, sum)
        return max_sum
