# leetcode problem number: 1291

class Solution:
    def sequentialDigits(self, low: int, high: int) -> List[int]:
        # 10 to 100 = 8
        # 100 to 1000 = 7
        # 1000 to 10000 = 6
        # 10000 to 100000 = 5
        # 100000 to 1000000 = 4
        # 1000000 to 10000000 = 3
        # 10000000 to 100000000 = 2
         # 100000000 to 1000000000 = 1 
        # 10 100 1000 10000 100000 1000000 10000000 100000000 1000000000
        # 0  8 7 6 5 4 3 2 1
        allPossible = [12, 23, 34, 45, 56, 67, 78, 89, 123, 234, 345, 456, 567, 678, 789, 1234, 2345, 3456, 4567, 5678, 6789,   12345, 23456, 34567, 45678, 56789, 123456, 234567, 345678, 456789, 1234567, 2345678, 3456789, 12345678, 23456789, 123456789]
        a, b = 0, len(allPossible) - 1

        for i in range(len(allPossible)):
            if allPossible[i] >= low:
                a = i
                break
        else:
            a = len(allPossible)  # low is bigger than everything

        for i in range(len(allPossible) - 1, -1, -1):
            if allPossible[i] <= high:
                b = i
                break
        else:
            b = -1  # high is smaller than everything
        return allPossible[a:b+1]



