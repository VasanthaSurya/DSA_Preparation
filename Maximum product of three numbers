# Maximum product of three numbers : Problem number: 628

class Solution:
    def maximumProduct(self, nums: List[int]) -> int:
        n = len(nums)
        for i in range(3):
            for j in range(i+1, n):
                if nums[i] < nums[j]:
                    nums[i], nums[j] = nums[j], nums[i]
        
        for i in range(n-1, n-4, -1):
            for j in range(i):
                if nums[i] > nums[j]:
                    nums[i], nums[j] = nums[j], nums[i]
        return max((nums[0] * nums[1] * nums[2]), nums[-1] * nums[-2] * nums[0])
